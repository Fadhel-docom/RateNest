# Framing is denied on every page by default. No page is meant to be embedded in another site today.
# A deliberate exception for /embed/hourly must be added only together with that exact page and verified on a
# Cloudflare preview (see docs/embed-feasibility-review-2026-11-02.md and docs/embed-publisher-target-research-2026-11-02.md); do not add it on its own.
/*
  Content-Security-Policy: frame-ancestors 'none'
  X-Frame-Options: DENY

# Cloudflare Pages serves the repository root, so keep internal notes and tooling out of search results.
/docs/*
  X-Robots-Tag: noindex, nofollow
/scripts/*
  X-Robots-Tag: noindex, nofollow
/tools/*
  X-Robots-Tag: noindex, nofollow
/.github/*
  X-Robots-Tag: noindex, nofollow
/CLAUDE.md
  X-Robots-Tag: noindex, nofollow
/README.md
  X-Robots-Tag: noindex, nofollow
/*.test.mjs
  X-Robots-Tag: noindex, nofollow
